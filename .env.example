CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_TOKEN=
CANVAS_TIMEZONE=Asia/Singapore
# Optional comma-separated allowed course IDs (not course codes):
CANVAS_COURSE_IDS=
# Optional comma-separated additional exam phrases:
CANVAS_EXAM_KEYWORDS=
CANVAS_DOCUMENT_REGISTRY=documents/registry.json
CANVAS_DOCUMENT_STORE=data/documents.sqlite3
# Optional additional exact institution hosts approved for document sources:
CANVAS_DOCUMENT_HOSTS=
# Local OCR fallback for scanned/image-only PDF pages. CPU is the safest default.
CANVAS_OCR_ENABLED=true
CANVAS_OCR_DEVICE=cpu
CANVAS_OCR_DPI=150
# OCR-derived facts below this line confidence remain unresolved.
CANVAS_OCR_MIN_CONFIDENCE=0.90
